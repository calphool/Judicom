[judicom]
type=endpoint
transport=transport-tailscale
context=from-judicom
disallow=all
allow=ulaw
auth=judicom-auth
aors=judicom
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
media_address=NAS_TAILSCALE_ADDRESS

[judicom-auth]
type=auth
auth_type=userpass
username=judicom
password=CHANGE_ME

[judicom]
type=aor
max_contacts=1
remove_existing=yes
