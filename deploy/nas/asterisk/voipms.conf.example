[voipms-auth]
type=auth
auth_type=userpass
username=VOIPMS_ACCOUNT_asterisk
password=CHANGE_ME
[voipms-registration]
type=registration
transport=transport-udp
outbound_auth=voipms-auth
server_uri=sip:chicago4.voip.ms
client_uri=sip:VOIPMS_ACCOUNT_asterisk@chicago4.voip.ms
retry_interval=60
forbidden_retry_interval=300
expiration=120
line=yes
endpoint=voipms
[voipms]
rtp_keepalive=1
type=endpoint
transport=transport-udp
context=from-voipms
disallow=all
allow=ulaw
outbound_auth=voipms-auth
aors=voipms
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
from_user=VOIPMS_ACCOUNT_asterisk
from_domain=chicago4.voip.ms

[voipms]
type=aor
contact=sip:chicago4.voip.ms:5060
qualify_frequency=60
[voipms-identify]
type=identify
endpoint=voipms
match=208.100.60.6
