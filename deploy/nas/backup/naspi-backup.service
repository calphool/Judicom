[Unit]
Description=Weekly NAS backup: /home/pi snapshot and NAS SD image copy (to /mnt/2tbdrive)
After=local-fs.target network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/2tbdrive

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/naspi_backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
